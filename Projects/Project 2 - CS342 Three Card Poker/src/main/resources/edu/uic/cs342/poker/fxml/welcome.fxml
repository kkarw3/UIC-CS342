<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.uic.cs342.poker.controller.WelcomeController">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_RIGHT" spacing="12">
            <Label fx:id="themeStatusLabel" text="Theme: Classic Casino Felt"/>
            <Button fx:id="themeToggleButton" text="Switch Theme" styleClass="secondary-button" onAction="#handleToggleTheme"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="22" maxWidth="680">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <Label text="THREE CARD POKER" styleClass="title-label"/>
            <Label text="Two-Player Independent Table Edition — Play Head-to-Head Against the Dealer"
                   styleClass="subtitle-label" wrapText="true" textAlignment="CENTER"/>

            <VBox styleClass="panel-box" spacing="14" alignment="CENTER" maxWidth="420">
                <Button fx:id="startButton" text="Start Game" maxWidth="280" onAction="#handleStartGame"/>
                <Button fx:id="rulesButton" text="Game Rules &amp; Payouts" styleClass="secondary-button" maxWidth="280" onAction="#handleToggleRules"/>
                <Button fx:id="exitButton" text="Exit Application" styleClass="fold-button" maxWidth="280" onAction="#handleExit"/>
            </VBox>

            <VBox fx:id="rulesBox" styleClass="panel-box" spacing="8" visible="false" managed="false">
                <Label text="How to Play &amp; Payout Rules" styleClass="section-title"/>
                <Label text="• Ante &amp; Pair Plus: Place an Ante ($5–$25) and an optional Pair Plus wager ($5–$25) before dealing." wrapText="true"/>
                <Label text="• Play or Fold: After viewing your 3 cards, match your Ante with a Play bet or Fold (forfeiting Ante &amp; Pair Plus)." wrapText="true"/>
                <Label text="• Dealer Qualification: Dealer needs Queen-High or better. If not qualified, Play is returned and Ante carries forward." wrapText="true"/>
                <Label text="• Pair Plus Payouts: Straight Flush (40:1) | Three of a Kind (30:1) | Straight (6:1) | Flush (3:1) | Pair (1:1)." wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>